<!-- Inserted into the generated Capacitor application by scripts/android/prepare.mjs. -->
<activity android:name=".HealthConnectPrivacyActivity" android:exported="true">
    <intent-filter>
        <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
    </intent-filter>
</activity>
<activity-alias android:name=".HealthConnectPermissionUsage" android:exported="true"
    android:targetActivity=".HealthConnectPrivacyActivity"
    android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
    <intent-filter>
        <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
        <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
    </intent-filter>
</activity-alias>
<!-- PHATBOT requires account sign-in and a data-use disclosure before syncing. -->
<activity android:name=".HealthConnectOnboardingActivity" android:exported="true"
    android:permission="com.google.android.apps.healthdata.permission.START_ONBOARDING">
    <intent-filter>
        <action android:name="androidx.health.ACTION_SHOW_ONBOARDING" />
    </intent-filter>
</activity>
<activity-alias android:name=".HealthConnectPlatformOnboarding" android:exported="true"
    android:targetActivity=".HealthConnectOnboardingActivity"
    android:permission="android.permission.health.START_ONBOARDING">
    <intent-filter>
        <action android:name="android.health.connect.action.SHOW_ONBOARDING" />
    </intent-filter>
</activity-alias>
